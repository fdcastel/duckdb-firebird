# name: test/sql/proof2_nested_password.test
# description: proof (fork only): nested password hidden
# group: [firebird]

require firebird

require-env FIREBIRD_RW_DB

statement ok
ATTACH '${FIREBIRD_RW_DB}' AS rw (TYPE firebird, READ_WRITE);

statement ok
SELECT * FROM firebird_execute('rw', 'EXECUTE BLOCK AS BEGIN EXECUTE STATEMENT ''CREATE USER FBX_P2N PASSWORD ''''s3cret-p2n''''''; END');

query I
SELECT remote_sql LIKE '%s3cret%' FROM firebird_last_query();
----
false
