# name: test/sql/firebird_health.test
# description: firebird_health - single-row DB/server health diagnostic:
#              factual metrics (version/ODS/dialect/charset/page/durability/
#              sweep/transaction counters/attachments) + structured warnings.
# group: [firebird]

require firebird

require-env FIREBIRD_TEST_DB

require-env ISC_PASSWORD

statement error
SELECT * FROM firebird_health(NULL);
----
firebird_health(alias VARCHAR): alias is required

statement error
SELECT * FROM firebird_health('nope_does_not_exist_xyz');
----
no attached catalog named 'nope_does_not_exist_xyz'

statement ok
ATTACH '${FIREBIRD_TEST_DB}' AS fb (TYPE firebird);

# Exactly one row.
query I
SELECT COUNT(*) FROM firebird_health('fb');
----
1

# Factual shape/range checks (exact transaction numbers vary per session).
query IIIIIII
SELECT
  CASE WHEN engine_version <> '' THEN 1 ELSE 0 END,
  CASE WHEN regexp_matches(ods_version, '^[0-9]+\.[0-9]+$') THEN 1 ELSE 0 END,
  CASE WHEN sql_dialect = 3 THEN 1 ELSE 0 END,
  CASE WHEN page_size > 0 THEN 1 ELSE 0 END,
  CASE WHEN next_transaction > 0 THEN 1 ELSE 0 END,
  CASE WHEN oit_gap >= 0 AND oat_gap >= 0 THEN 1 ELSE 0 END,
  CASE WHEN attachments >= 1 THEN 1 ELSE 0 END
FROM firebird_health('fb');
----
1	1	1	1	1	1	1

# Default charset of the UTF8 fixture, and no charset_none warning for it.
query TT
SELECT default_charset, list_contains(warnings, 'charset_none')
FROM firebird_health('fb');
----
UTF8	false

# warnings is a LIST(VARCHAR) (type-stable even when empty/non-empty).
query T
SELECT typeof(warnings) FROM firebird_health('fb');
----
VARCHAR[]

# ---------------------------------------------------------------------------
#  Inline blobs (Firebird 5.0.3+ client AND server). client_version is the
#  loaded fbclient (normalized to major.minor.patch.build); inline_blob_size
#  is the effective limit, or NULL when either side is older than 5.0.3
#  (a 5.0.3+ client reports a size even to an older server, so the server
#  version must be part of the decision).
# ---------------------------------------------------------------------------

query I
SELECT regexp_matches(client_version, '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
FROM firebird_health('fb');
----
true

statement ok
CREATE OR REPLACE TABLE inline_expect AS
SELECT
  (CAST(split_part(engine_version, '.', 1) AS INTEGER) * 10000 +
   CAST(split_part(engine_version, '.', 2) AS INTEGER) * 100 +
   CAST(split_part(engine_version, '.', 3) AS INTEGER)) >= 50003 AS server_ok,
  (CAST(split_part(client_version, '.', 1) AS INTEGER) * 10000 +
   CAST(split_part(client_version, '.', 2) AS INTEGER) * 100 +
   CAST(split_part(client_version, '.', 3) AS INTEGER)) >= 50003 AS client_ok
FROM firebird_health('fb');

# Default (setting -1, nothing sent): the client default 65535 when both
# sides support it, NULL otherwise. The warning fires only for a 5.0.3+
# server reached through an older client.
query II
SELECT
  CASE WHEN e.server_ok AND e.client_ok THEN h.inline_blob_size = 65535
       ELSE h.inline_blob_size IS NULL END,
  list_contains(h.warnings, 'inline_blobs_unavailable') = (e.server_ok AND NOT e.client_ok)
FROM firebird_health('fb') h, inline_expect e;
----
true	true

# A new ATTACH picks up the session setting: 0 disables inlining.
statement ok
SET firebird_max_inline_blob_size = 0;

statement ok
ATTACH '${FIREBIRD_TEST_DB}' AS fb_noinline (TYPE firebird);

query I
SELECT CASE WHEN e.server_ok AND e.client_ok THEN h.inline_blob_size = 0
            ELSE h.inline_blob_size IS NULL END
FROM firebird_health('fb_noinline') h, inline_expect e;
----
true

statement ok
DETACH fb_noinline;

# Out of range: rejected when a connection would be opened (ATTACH or a
# firebird_scan() bind), with the accepted range in the message.
statement ok
SET firebird_max_inline_blob_size = 70000;

statement error
ATTACH '${FIREBIRD_TEST_DB}' AS fb_bad (TYPE firebird);
----
firebird_max_inline_blob_size must be -1 (client default) or 0..65535

statement error
SELECT COUNT(*) FROM firebird_scan('${FIREBIRD_TEST_DB}', 'EMPLOYEE');
----
firebird_max_inline_blob_size must be -1 (client default) or 0..65535

statement ok
SET firebird_max_inline_blob_size = -1;

# Scans keep working with inlining tuned down (blob values unchanged).
statement ok
SET firebird_max_inline_blob_size = 16;

query I
SELECT COUNT(*) > 0 FROM firebird_scan('${FIREBIRD_TEST_DB}', 'EMPLOYEE');
----
true

statement ok
RESET firebird_max_inline_blob_size;
