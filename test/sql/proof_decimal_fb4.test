# name: test/sql/proof_decimal_fb4.test
# description: proof (fork only): wide DECIMAL per row on Firebird 4+
# group: [firebird]

require firebird

require-env FIREBIRD_RW4_DB

statement ok
ATTACH '${FIREBIRD_RW4_DB}' AS rw (TYPE firebird, READ_WRITE);

statement ok
SELECT * FROM firebird_execute('rw', 'INSERT INTO RW_TARGET (ID, C_NUM18_4) VALUES (?, ?)',
    source := 'SELECT 992, 1.12345678901234567891::DECIMAL(38,20)');

query I
SELECT C_NUM18_4 FROM rw.main.RW_TARGET WHERE ID = 992;
----
1.1235
