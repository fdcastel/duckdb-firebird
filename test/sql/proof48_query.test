# name: test/sql/proof48_query.test
# description: proof (fork only): the firebird_query half of firebird_session_reset.test
# group: [firebird]
#
# Needs scripts/fixture_rw.sql in the database named by FIREBIRD_RW_DB.
# Each step runs alone, so the pool (LIFO) hands the same connection to the
# next step. With the reset off, a context variable set by one call reaches
# the next: that proves the reuse. With it on, the next call sees NULL on
# Firebird 4+; Firebird 3 has no session reset.

require firebird

require-env FIREBIRD_RW_DB

statement ok
ATTACH '${FIREBIRD_RW_DB}' AS ro (TYPE firebird);

statement ok
ATTACH '${FIREBIRD_RW_DB}' AS rw (TYPE firebird, READ_WRITE);

statement ok
CREATE TABLE fb_major AS
SELECT V AS major
  FROM firebird_query('ro', 'SELECT CAST(SUBSTRING(RDB$GET_CONTEXT(''SYSTEM'', ''ENGINE_VERSION'') FROM 1 FOR 1) AS INTEGER) AS V FROM RDB$DATABASE');

# --- firebird_query ----------------------------------------------------------------

statement ok
SET firebird_pool_session_reset = false;

statement ok
SELECT * FROM firebird_query('ro', 'SELECT RDB$SET_CONTEXT(''USER_SESSION'', ''K48Q'', ''leak'') AS R FROM RDB$DATABASE');

query T
SELECT * FROM firebird_query('ro', 'SELECT RDB$GET_CONTEXT(''USER_SESSION'', ''K48Q'') AS V FROM RDB$DATABASE');
----
leak

statement ok
SET firebird_pool_session_reset = true;

statement ok
SELECT * FROM firebird_query('ro', 'SELECT RDB$SET_CONTEXT(''USER_SESSION'', ''K48Q'', ''leak'') AS R FROM RDB$DATABASE');

query T
SELECT V IS NOT DISTINCT FROM CASE WHEN m.major >= 4 THEN NULL ELSE 'leak' END
  FROM firebird_query('ro', 'SELECT RDB$GET_CONTEXT(''USER_SESSION'', ''K48Q'') AS V FROM RDB$DATABASE'), fb_major m;
----
true

