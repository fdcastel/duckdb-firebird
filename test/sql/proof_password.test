# name: test/sql/proof_password.test
# description: proof (fork only): password literal redacted
# group: [firebird]

require firebird

require-env FIREBIRD_RW_DB

statement ok
ATTACH '${FIREBIRD_RW_DB}' AS rw (TYPE firebird, READ_WRITE);

statement ok
SELECT * FROM firebird_execute('rw', 'CREATE USER FBX_P32 PASSWORD ''s3cret-p32''');

query I
SELECT remote_sql LIKE '%s3cret%' FROM firebird_last_query();
----
false
